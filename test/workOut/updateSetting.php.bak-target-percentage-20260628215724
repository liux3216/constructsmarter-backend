function parseTargetAreaIds($value) {
    if ($value === null || $value === "") return [];
    $decoded = json_decode((string)$value, true);
    $items = is_array($decoded) ? $decoded : preg_split('/\s*,\s*/', (string)$value, -1, PREG_SPLIT_NO_EMPTY);
    return array_values(array_unique(array_filter(array_map(fn($id) => (int)$id, $items), fn($id) => $id > 0)));
}

function syncTargetAreas($db, $settingId, $targetAreaIds) {
    $db->exec("DELETE FROM `workOutSettingTargetAreas` WHERE `workOutSettingId` = ?;", [$settingId], __FILE__, __LINE__);
    foreach ($targetAreaIds as $targetAreaId) {
        $db->exec(
            "INSERT IGNORE INTO `workOutSettingTargetAreas` (`workOutSettingId`, `targetAreaId`) VALUES (?, ?);",
            [$settingId, $targetAreaId], __FILE__, __LINE__
        );
    }
}

